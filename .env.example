# Copy this file to .env and fill in real values.
# All variables are required at runtime — the app will not start without them.

# --- Core ------------------------------------------------------------------
NODE_ENV=production
PORT=3100
HOSTNAME=127.0.0.1
NEXT_PUBLIC_APP_URL=https://trek.uz

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/trek_db

# --- Sessions --------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Cron / scheduled jobs -------------------------------------------------
# Shared secret required by GET /api/cron/notifications and similar endpoints.
CRON_SECRET=

# --- Telegram -------------------------------------------------------------
# BotFather token (123456:ABC...) — drives Telegram login + bot replies.
TELEGRAM_BOT_TOKEN=
# Public bot username (no @) — used to render the Telegram Login Widget.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=trekcalendar_bot

# --- AI -------------------------------------------------------------------
# Anthropic API key for the onboarding & Pro chat assistants.
ANTHROPIC_API_KEY=

# --- Payme (Uzbek payment provider) ---------------------------------------
# These are only required if you enable paid subscriptions.
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=
